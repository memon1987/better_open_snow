# Firestore emulator — Python services read this env var and route reads/writes
# to the local emulator instead of production.
FIRESTORE_EMULATOR_HOST=localhost:8080

# Firebase project ID. `demo-*` prefix tells the emulator this is never a real
# project, so it refuses any accidental prod calls.
GOOGLE_CLOUD_PROJECT=demo-bos

# Expo web client reads this at build time to know where the API lives.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
