rules_version = '2';

// Deny-all. The emulator ignores rules when clients authenticate as admin,
// which is how our Python services connect. The web app never talks to
// Firestore directly — it only goes through the FastAPI service.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
